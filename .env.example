# Copie para .env e preencha com sua chave (nunca commitar .env).
# Conta: https://platform.openai.com — billing prepaid (min. US$ 5).

OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
# Ancora PT (evita russo no auto-detect). Prompt interno libera titulos em ingles.
# OPENAI_STT_LANGUAGE=pt
# Em modelos que aceitam lista (ex. gpt-transcribe): OPENAI_STT_LANGUAGES=pt,en
# OPENAI_STT_PROMPT=...

# Wi-Fi (scripts.connect_wifi) — nao commitar senhas reais
# Ordem no boot: MAUA primeiro; se falhar, Leonardo / Apto_163
# WIFI_BOOTSTRAP_ORDER=MAUA,Leonardo,Apto_163
# WIFI_BOOTSTRAP_RETRIES=5
# WIFI_BOOTSTRAP_DELAY=8
# WIFI_SSID=Leonardo
# WIFI_MAUA_PASSWORD=
# WIFI_LEONARDO_PASSWORD=sua-senha-casa
# WIFI_APTO_163_PASSWORD=sua-senha-apto

# Opcional — padrao abaixo se omitido:
# VOSK_MODEL_PATH=models/vosk-model-small-pt-0.3
# MIC_GAIN=10
# WAKE_BLOCK_MS=80
# WAKE_ENERGY_FACTOR=2.2
# MIN_SPEECH_PEAK=350
# SPEECH_THRESHOLD=2800
# COMMAND_SILENCE_TIMEOUT=1.0
# BUZZER_GPIO=27
# BUZZER_MODE=tone
# BUZZER_FREQ_HZ=2000
# Saida do bip (PortAudio). Em branco = auto (bcm2835 Headphones / jack P2).
# SPEAKER_DEVICE=0
# Saida das musicas no mpv (mesmo jack P2; nome da placa, nao indice):
# MPV_AUDIO_DEVICE=alsa/plughw:CARD=Headphones,DEV=0

# Dashboard web (FastAPI) + ngrok
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8080
# Obrigatorio para acesso remoto via ngrok:
DASHBOARD_TOKEN=troque-este-token
# 1 = sobe o motor de voz junto com o dashboard
# ENGINE_AUTOSTART=1
