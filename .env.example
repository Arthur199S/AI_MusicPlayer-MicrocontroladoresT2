# Copie para .env e preencha com sua chave (nunca commitar .env).
# Conta: https://platform.openai.com — billing prepaid (min. US$ 5).

OPENAI_API_KEY=sk-sua-chave-aqui
OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# Opcional — padrao abaixo se omitido:
# VOSK_MODEL_PATH=models/vosk-model-small-pt-0.3
# BUZZER_GPIO=27
# BUZZER_MODE=tone
# BUZZER_FREQ_HZ=2000
# Saida do bip (PortAudio). 1 = bcm2835 Headphones (hw:3,0) neste Pi.
# SPEAKER_DEVICE=1
# Saida das musicas no mpv (mesmo jack do speaker-test):
# MPV_AUDIO_DEVICE=alsa/plughw:3,0
